{
  "name": "rca-navigator-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "RCA Navigator packaged as a native Android/iOS app via Capacitor",
  "scripts": {
    "prepare-web": "cp ../rca-process-map.html www/index.html",
    "sync": "npm run prepare-web && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2"
  }
}
